# =============================================================================
# trtSchuelermanager – .gitignore
# Passend für Web-Projekte (HTML/CSS/Vanilla JS)
# =============================================================================

# ----- Betriebssystem-Dateien -----
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ----- Editor / IDE -----
# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains (WebStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ----- Abhängigkeiten (falls später ein Build-Tool hinzukommt) -----
node_modules/
bower_components/

# ----- Build-Ausgaben -----
dist/
build/
out/

# ----- Paket-Manager-Logs -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ----- Umgebungs-Variablen -----
.env
.env.local
.env.*.local

# ----- Temporäre Dateien -----
*.tmp
*.temp
*.bak
*.swp

# ----- Logs -----
logs/
*.log
